# Token do bot do Telegram — gere com o @BotFather
TELEGRAM_BOT_TOKEN=cole_seu_token_aqui

# Chave da API oficial da Anthropic — pegue em console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# (Opcional) modelo a usar — padrão é claude-haiku-4-5 (mais barato)
# Outras opções: claude-sonnet-4-6 (mais inteligente, mais caro)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
